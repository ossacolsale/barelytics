Options -Indexes

# Revalidate the tracker after FTP updates without disabling conditional requests.
# Other assets retain the hosting policy. See docs/reach-troubleshooting.md.
<Files "track.js">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header onsuccess unset Cache-Control
        Header always set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</Files>

<FilesMatch "(?i)(\.sqlite(?:3)?(?:-wal|-shm|-journal)?|\.db(?:-wal|-shm|-journal)?|\.sql|\.bak|\.backup|\.zip|\.env|\.ini|\.log|setup\.token|reset\.token)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(?:config|settings|analytics)(?:\.|$)">
    Require all denied
</FilesMatch>
